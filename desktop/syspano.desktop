[Desktop Entry]
Type=Application
Name=SysPano Sistem Panosu
Comment=CPU, bellek, sıcaklık, fan, pil, GPU, disk ve ağ izleme panosu
# Kurulumdan sonra 'which syspano' ile bulduğunuz yolu yazın, ya da
# install.sh bu dosyayı sizin için ~/.config/autostart içine üretir.
Exec=syspano
Icon=utilities-system-monitor
Terminal=false
NoDisplay=true
Categories=System;Monitor;
X-GNOME-Autostart-enabled=true
X-KDE-autostart-after=panel
