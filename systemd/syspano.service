[Unit]
Description=SysPano sistem ve kaynak izleme panosu
Documentation=https://github.com/ornek/syspano
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=@KOMUT@
Restart=on-failure
RestartSec=5
# Pano X11/Xwayland üzerinden çizilir; oturum değişkenleri gerekir.
Environment=SYSPANO_SERVIS=1

[Install]
WantedBy=graphical-session.target
